#!/bin/bash
# fn-socks - 服务启停主脚本
# 用法: main start|stop|status

SERVICE_NAME="fn-socks"
PY="$(command -v python3 || echo /usr/bin/python3)"
SERVER_DIR="$TRIM_APPDEST/server"
WWW_DIR="$TRIM_APPDEST/www"
DATA_DIR="$TRIM_PKGVAR"
PID_FILE="$DATA_DIR/server.pid"
PORT="${TRIM_SERVICE_PORT:-15666}"

ensure_dirs() {
  mkdir -p "$DATA_DIR/logs"
}

start() {
  ensure_dirs
  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      exit 0
    fi
    rm -f "$PID_FILE"
  fi
  if [ ! -x "$PY" ]; then
    echo "未找到 python3，请先安装 Python 运行时" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  nohup "$PY" "$SERVER_DIR/main.py" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --data-dir "$DATA_DIR" \
    --www-dir "$WWW_DIR" \
    --core-path "$TRIM_APPDEST/bin/sing-box" \
    --log-level info \
    --no-auto-token \
    >> "$DATA_DIR/logs/app.log" 2>&1 &
  echo $! > "$PID_FILE"
  # 健康探测：最多等候 8s，期间轮询 /api/status（带 Authorization 头）以确认存活
  PID="$(cat "$PID_FILE" 2>/dev/null)"
  HEALTH_OK=0
  for i in $(seq 1 16); do
    if [ -z "$PID" ] || ! kill -0 "$PID" 2>/dev/null; then
      echo "服务进程已退出，请查看日志: $DATA_DIR/logs/app.log" > "$TRIM_TEMP_LOGFILE"
      rm -f "$PID_FILE"
      exit 1
    fi
    # 健康探测：HTTP 200 即可，鉴权层会回 401 但说明 web 已就绪
    CODE="$( curl -s -o /dev/null -w '%{http_code}' --max-time 1 "http://127.0.0.1:$PORT/api/status" 2>/dev/null )"
    if [ "$CODE" = "200" ] || [ "$CODE" = "401" ]; then
      HEALTH_OK=1
      break
    fi
    sleep 0.5
  done
  if [ "$HEALTH_OK" = "1" ] && kill -0 "$PID" 2>/dev/null; then
    exit 0
  fi
  echo "服务启动失败（健康探测未通过），请查看日志: $DATA_DIR/logs/app.log" > "$TRIM_TEMP_LOGFILE"
  exit 1
}

stop() {
  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$PID" ]; then
      kill "$PID" 2>/dev/null
      sleep 1
      kill -9 "$PID" 2>/dev/null
    fi
    rm -f "$PID_FILE"
  fi
  # 兜底：清理 sing-box 核心进程（后端正常退出会自动停止，此处防残留）
  SB_PID_FILE="$DATA_DIR/core/core.pid"
  if [ -f "$SB_PID_FILE" ]; then
    SB_PID="$(cat "$SB_PID_FILE" 2>/dev/null)"
    if [ -n "$SB_PID" ]; then
      kill "$SB_PID" 2>/dev/null
      sleep 1
      kill -9 "$SB_PID" 2>/dev/null
    fi
    rm -f "$SB_PID_FILE" 2>/dev/null
  fi
  exit 0
}

status() {
  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      exit 0
    fi
    rm -f "$PID_FILE"
  fi
  exit 3
}

case "$1" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) echo "Usage: $0 start|stop|status" > "$TRIM_TEMP_LOGFILE"; exit 1 ;;
esac